{
  "expo": {
    "name": "Arclo: Fitness Planner",
    "slug": "tempo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tempo",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/bdb2dc2b-4340-4191-8a7f-4411fb56734f"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "bundleIdentifier": "com.fittempo.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:fittempo.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCalendarsUsageDescription": "Arclo uses your calendar to schedule workouts around your life.",
        "NSCalendarsFullAccessUsageDescription": "Arclo reads your calendar to schedule workouts around your life, and \u2014 only when you turn it on \u2014 adds your sessions to it.",
        "NSCalendarsWriteOnlyAccessUsageDescription": "Arclo adds your scheduled workouts to your calendar when you turn that on.",
        "NSRemindersUsageDescription": "Arclo sends reminders before your scheduled workouts.",
        "NSUserNotificationsUsageDescription": "Arclo sends reminders before your scheduled workouts.",
        "NSPhotoLibraryUsageDescription": "Arclo lets you attach progress photos to your measurements. Photos stay private to your account."
      }
    },
    "android": {
      "package": "com.fittempo.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "fittempo.app",
              "pathPrefix": "/w"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-calendar",
        {
          "calendarPermission": "Arclo needs calendar access to schedule your workouts.",
          "remindersPermission": "Arclo needs reminder access to send workout alerts."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#3B82F6",
          "defaultChannel": "workouts"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-sharing",
      "@sentry/react-native/expo",
      "expo-widgets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bdb2dc2b-4340-4191-8a7f-4411fb56734f"
      }
    },
    "owner": "jacobr0911"
  }
}
